// Четене на NTC датчик за температура (Steinhart–Hart конверсия)
#include "NTC.h"

// Алгоритъм:
// 1) Четем `Br` проби от аналоговия вход и изчисляваме средна стойност (шумопотискане).
// 2) Преобразуваме средното ADC напрежение в съпротивление на термистора:
//      RT = R2 / (1023.0 / Du - 1)
//    където R2 е опорният резистор в делителя.
// 3) Използваме Steinhart–Hart формулата с коефициенти c1,c2,c3 за изчисляване на T(K).
// 4) Конвертираме от Келвин в Целзий и връщаме температурата.

float NTC(int Tpin)
{
  float Duu = 0;
  const int Br = 10; // брой проби за средна стойност
  for (int i = 0; i < Br; i++)
  {
    Duu += (float)analogRead(Tpin);
    delay(10); // кратко изчакване между четенията
  }

  // средно ADC значение
  Du = Duu / Br;

  // преобразуване ADC -> съпротивление на термистора
  RT = R2 / (1023.0 / Du - 1.0);

  // Steinhart-Hart: изчисляваме log(R) и температурата в Келвини
  logR2 = (float)log(RT);
  T = (float)(1.0 / (c1 + c2 * logR2 + c3 * logR2 * logR2 * logR2));
  // конверсия в Целзий
  T = T - 273.15;

  return T;
}



